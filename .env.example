# Variables de entorno para el Portfolio de Raúl Dávila
# Copia este archivo a .env y rellena los valores reales

# EmailJS Configuration (opcional - ya configurado en src/config/emailjs.config.js)
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# URL base para despliegue (opcional)
# VITE_BASE_URL=/
# VITE_API_BASE_URL=https://tu-api.com/api

# Configuración de análisis (opcional)
# VITE_GA_TRACKING_ID=your_google_analytics_id
# VITE_HOTJAR_ID=your_hotjar_id

# Modo desarrollo/producción
# NODE_ENV=production
